{
  "name": "aha-slide-types-public",
  "private": false,
  "version": "0.0.1",
  "type": "module",
  "description": "PUBLIC slide-plugin frontend for AhaSlides. Vite + Vue 3 + Ant Design Vue with the three host surfaces (Canvas / Settings / Audience), consuming the @aha/* SDK token-free from aha-slide-plugin GitHub Release tarballs.",
  "packageManager": "npm@10.9.5",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@aha/api": "https://github.com/AhaSlides-Product/aha-slide-plugin/releases/download/sdk-latest/aha-api.tgz",
    "@aha/common": "https://github.com/AhaSlides-Product/aha-slide-plugin/releases/download/sdk-latest/aha-common.tgz",
    "@aha/db": "https://github.com/AhaSlides-Product/aha-slide-plugin/releases/download/sdk-latest/aha-db.tgz",
    "@aha/design": "https://github.com/AhaSlides-Product/aha-slide-plugin/releases/download/sdk-latest/aha-design.tgz",
    "@aha/ui": "https://github.com/AhaSlides-Product/aha-slide-plugin/releases/download/sdk-latest/aha-ui.tgz",
    "@aha/ui-vanilla": "https://github.com/AhaSlides-Product/aha-slide-plugin/releases/download/sdk-latest/aha-ui-vanilla.tgz",
    "@ant-design/icons-vue": "^7.0.0",
    "ant-design-vue": "4.2.6",
    "lodash-es": "^4.17.21",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.7",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "unplugin-icons": "^23.0.1",
    "vue-tsc": "^3.1.4"
  }
}
