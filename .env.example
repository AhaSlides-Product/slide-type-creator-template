# Default slide type for the dev landing redirect (/ -> /<type>/canvas/<id> style).
VITE_AHA_DEFAULT_SLIDE=demo

# Deploy base path when hosted under a sub-path (host mounts the plugin iframe).
# VITE_BASE_PATH=/

# Backend is deferred. `/api/*` is proxied in dev (see vite.config.ts) to the
# shared slide-type-creator endpoints; set an absolute base for a static prod build.
VITE_API_BASE=
